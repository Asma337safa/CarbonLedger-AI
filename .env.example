# ------------------------------------------------------------------
# CarbonLedger AI — exemple de configuration.
# Copier ce fichier en `.env` puis ajuster les valeurs.
# Ne JAMAIS committer le fichier `.env` réel (secrets).
# ------------------------------------------------------------------

# Environnement : development | production
CARBONLEDGER_ENV=development

# Clé secrète applicative (signature des cookies auxiliaires, jetons).
# Générer une valeur unique en production : python -c "import secrets;print(secrets.token_urlsafe(48))"
CARBONLEDGER_SECRET_KEY=changez-cette-valeur-en-production

# URL publique de l'application (utilisée dans les liens d'invitation)
CARBONLEDGER_BASE_URL=http://127.0.0.1:8000

# Base de données.
# - SQLite local (par défaut, sans installation) :
CARBONLEDGER_DATABASE_URL=sqlite:///data/carbonledger.db
# - PostgreSQL (production) :
# CARBONLEDGER_DATABASE_URL=postgresql+psycopg://user:motdepasse@localhost:5432/carbonledger

# Répertoire de travail des données (base SQLite, imports temporaires, rapports générés)
CARBONLEDGER_DATA_DIR=data

# Sécurité
CARBONLEDGER_MAX_UPLOAD_MB=5
CARBONLEDGER_SESSION_DAYS=14
# Mettre true derrière HTTPS (production)
CARBONLEDGER_COOKIE_SECURE=false

# ------------------------------------------------------------------
# Assistant « CarbonLedger Copilot » (facultatif).
# Si aucune clé API n'est fournie, l'application reste pleinement
# utilisable : le Copilot bascule en mode démonstration déterministe.
# Compatible avec toute API au format OpenAI (OpenAI, Azure, Mistral, Ollama…).
# ------------------------------------------------------------------
CARBONLEDGER_AI_API_KEY=
CARBONLEDGER_AI_BASE_URL=https://api.openai.com/v1
CARBONLEDGER_AI_MODEL=gpt-4o-mini
